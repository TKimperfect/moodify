# Copy this file to ".env" (same folder) and fill in the values.
# The ".env" file holds private settings and is never uploaded to GitHub.

# Port the backend listens on
PORT=4000

# "development" on your computer, "production" when deployed
NODE_ENV=development

# Address(es) of the frontend allowed to call this backend, separated by
# commas. When deployed, e.g.: https://moodify-yourname.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------
# Supabase (database + user accounts)
# Leave these empty to run MOODIFY without a database:
# recommendations and Discover still work from the built-in sample songs.
#
# Find them in the Supabase dashboard:
#   SUPABASE_URL             -> "Connect" button at the top, or Project Settings > Data API
#                               (looks like https://abcdefgh.supabase.co)
#   SUPABASE_PUBLISHABLE_KEY -> Project Settings > API Keys > Publishable key (starts with sb_publishable_)
#   SUPABASE_SECRET_KEY      -> Project Settings > API Keys > Secret key      (starts with sb_secret_)
#
# The SECRET key can read and change everything. Never share it,
# never put it in the "client" folder, never upload it.
# ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------
# AI mood assistant (optional, paid)
# Leave empty to use the free rule-based assistant, which always works.
# With a key, the assistant uses Claude for more natural conversations
# (and answers in the language the user writes in). Usage is billed by
# Anthropic per message. Create a key at https://console.anthropic.com
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Which Claude model to use (default: claude-opus-5-5).
ANTHROPIC_MODEL=

# ---------------------------------------------------------------
# Jamendo (optional, free) - full Creative Commons songs for the
# catalogue, free for NON-COMMERCIAL projects. Each song's licence is
# shown next to it. Get a client id at https://devportal.jamendo.com
# then run:  npm run music:import
# ---------------------------------------------------------------
JAMENDO_CLIENT_ID=

# ---------------------------------------------------------------
# Deezer (free, no key) - search for well-known songs with
# 30-second previews. On by default; set to false to switch it off.
# ---------------------------------------------------------------
DEEZER_ENABLED=true

# ---------------------------------------------------------------
# Spotify (optional) - real song search with "Open in Spotify" links.
# Leave empty to skip. Spotify does NOT allow full-song playback through
# its Web API, and gives 30-second previews for few or no songs.
# Since February 2026, Development Mode apps only work while the app
# owner has Spotify Premium.
# Create an app at https://developer.spotify.com/dashboard
# ---------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Two-letter country code for search results, e.g. US, MY, GB (optional)
SPOTIFY_MARKET=
