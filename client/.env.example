# Copy this file to ".env" (same folder).
# Only variables starting with VITE_ are visible to the browser,
# so NEVER put secret keys in this file.

# Leave empty in development: requests to /api are forwarded to the
# backend automatically (see vite.config.js).
# In production, set it to your deployed backend, e.g. https://api.example.com
VITE_API_URL=
